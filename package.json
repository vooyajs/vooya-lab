{
  "name": "vooya-lab",
  "private": true,
  "version": "0.1.0",
  "description": "Browser integration laboratory for Vooya Rust/WASM components.",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "pnpm --filter @vooya-lab/web dev",
    "build": "pnpm --filter @vooya-lab/web build",
    "build:pages": "pnpm build && node scripts/prepare-pages.mjs",
    "verify:vooya-registry": "node scripts/verify-vooya-registry.mjs",
    "validate:cases": "node scripts/validate-cases.mjs",
    "typecheck": "pnpm --filter @vooya-lab/web typecheck",
    "test:e2e": "pnpm --filter @vooya-lab/web test:e2e",
    "wasm-assets:dev": "pnpm exec wrangler dev --config workers/wasm-assets/wrangler.jsonc",
    "wasm-assets:deploy": "pnpm exec wrangler deploy --config workers/wasm-assets/wrangler.jsonc"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "wrangler": "^4.125.0"
  }
}
