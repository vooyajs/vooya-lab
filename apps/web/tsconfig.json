{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "vue": ["./node_modules/vue"],
      "vue-router": ["./node_modules/vue-router"],
      "@vooya-lab/ide": ["../../packages/ide/src/index.ts"],
      "@lab-web/*": ["./src/*"],
      "@lab-cases/*": ["../../cases/*"]
    },
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "allowArbitraryExtensions": true,
    "rootDirs": ["../..", "../../.vooya/types"],
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts", "../../cases/examples/**/*.ts", "../../cases/examples/**/*.vue", "../../.vooya/types/**/*.ts"]
}
